# Copy to server/.env (git-ignored) for local runs. On Render, set these in the dashboard.

# --- Supabase (leave unset for dev mode: in-memory DB + files in server/.data) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role key: Project Settings -> API. Server-side only!>

# --- Security ---
# ADMIN_TOKEN=<long random string; required with Supabase>
# OTA_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"   (python scripts/gen_signing_key.py)

# --- URLs ---
# PUBLIC_BASE_URL=http://192.168.1.50:8000   # dev mode: the address your ESP32 uses to reach this machine

# --- Evolution ---
# TRAINER=mock              # mock | torch | remote
# REMOTE_TRAINER_URL=
# TEACHER=rule              # rule | claude  (claude needs ANTHROPIC_API_KEY or an `ant auth login` profile)
# ANTHROPIC_API_KEY=
# TEACHER_MODEL=claude-opus-5-5
# TEACHER_MAX_CALLS_PER_RUN=50
# TEACHER_LESSONS_PER_RUN=5   # new chat topics the teacher writes each run (one call); 0 = none
# EVOLUTION_MIN_NEW_LOGS=200
# EVOLUTION_INTERVAL_S=21600
# TRAIN_STEPS=300
# TRAIN_METHOD=full         # full | lora
# AUTO_ACTIVATE=true
